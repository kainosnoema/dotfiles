# Shared git config.
#
# Included from ~/.gitconfig, which stays a machine-local file (gh auth
# setup-git and other tools write to it). Machine- or work-specific settings
# go there, after the [include], so they override these.

[user]
	name = Evan Owen
	email = kainosnoema@gmail.com
	useConfigOnly = true
[core]
	# Cursor for people, a no-op for agents and scripts (see bin/git-editor)
	editor = ~/.local/bin/git-editor
	excludesfile = ~/.gitignore
[init]
	defaultBranch = main
[color]
	ui = auto
[column]
	ui = auto
[branch]
	sort = -committerdate
[diff]
	algorithm = histogram
[help]
	autocorrect = prompt
[alias]
	br = branch
	ci = commit -s -v
	co = checkout
	di = diff
	st = status
	h  = "!source ~/.githelpers && show_git_head"
	l  = "!source ~/.githelpers && pretty_git_log"
	pr = "!gh pr create"
	fixup = !sh -c 'git commit -m \"fixup! $(git log -1 --format='\\''%s'\\'' $@)\"' -
	squash = !sh -c 'git commit -m \"squash! $(git log -1 --format='\\''%s'\\'' $@)\"' -
	recommit = commit --amend -CHEAD
	prune-merged = "!source ~/.githelpers && prune_merged"
	# git update [branch]: check out branch (default: origin's default), pull, prune merged
	update = "!source ~/.githelpers && update_branch"
	# git prune-gone: delete local branches whose remote branch is gone (squash-merged PRs)
	prune-gone = "!source ~/.githelpers && prune_gone"
[push]
	default = current
	autoSetupRemote = true
[pull]
	rebase = true
[fetch]
	prune = true
[merge]
	conflictstyle = zdiff3
[rebase]
	autosquash = true
	autostash = true
	updateRefs = true
[credential]
	helper = osxkeychain
[github]
	user = kainosnoema
[rerere]
	enabled = 1
	autoupdate = true
[tag]
	sort = version:refname
[url "git@github.com:"]
	insteadOf = https://github.com/
