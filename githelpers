#!/bin/bash

# Log output:
#
# * 51c333e    (2012-07-12)    <Evan Owen>   make important changes
#
# The log format uses } characters between each field, and `column` is later
# used to split on them. A } in the commit subject or any other field will
# break this.

HASH="%C(yellow)%h%Creset"
ABSOLUTE_TIME="%C(green)%ad%Creset"
AUTHOR="%C(bold blue)%an%Creset"
REFS="%C(red)%d%Creset"
SUBJECT="%s"

FORMAT="$HASH}$ABSOLUTE_TIME}$AUTHOR}$SUBJECT"

# Branches that prune_merged never deletes.
PROTECTED="main|master"

show_git_head() {
  echo "$(pretty_git_log -1) $(git show --color -p --pretty="tformat:")" |
    less -FXRS
}

pretty_git_log() {
  git log --pretty="tformat:${FORMAT}" --date=short "$@" |
    # Line columns up based on } delimiter
    column -s '}' -t |
    # Page only if we need to
    less -FXRS
}

# The remote's default branch (origin/HEAD), falling back to main.
default_branch() {
  local ref
  ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  echo "${ref#origin/}" | grep . || echo main
}

# git update [branch]: check out branch (default: the remote's default branch),
# pull, and prune merged local branches.
update_branch() {
  git checkout "${1:-$(default_branch)}" && git pull && prune_merged_local
}

prune_merged() {
  if [ -n "$1" ]; then
    prune_merged_remotes "$@"
  else
    prune_merged_local
  fi
}

# Delete local branches merged into HEAD, skipping the current branch (*),
# branches checked out in other worktrees (+), and protected branches.
prune_merged_local() {
  git branch --list --merged |
    grep --invert-match -E "^[*+]|^ *($PROTECTED)\$" |
    xargs -n 1 git branch --delete
}

# Delete local branches whose upstream was deleted on the remote, e.g. after a
# PR was squash-merged (which --merged can't detect). Lists them and asks once.
# A branch with unpushed commits is deleted too; recover it with `git reflog`.
prune_gone() {
  git fetch --prune --quiet origin || return
  local branches
  branches=$(git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads |
    awk '$2 == "[gone]" { print $1 }' |
    grep --invert-match -E "^($PROTECTED)\$")
  [ -z "$branches" ] && { echo "No branches with a deleted upstream."; return; }
  echo "Branches whose remote branch is gone:"
  echo "$branches" | sed 's/^/  /'
  printf "Delete them? [y/N] "
  read -r answer
  [ "$answer" = y ] || [ "$answer" = Y ] || return
  # git refuses to delete a branch checked out here or in another worktree.
  echo "$branches" | xargs -n 1 git branch -D
}

# Delete remote branches merged into $1 (asks before each one).
prune_merged_remotes() {
  git fetch origin
  git remote prune origin
  git branch --list --remote --merged "$1" |
    grep --invert-match -E "HEAD|origin/($PROTECTED)\$|origin/$1\$" |
    sed 's/ *origin\///' |
    xargs -p -I branch git push origin :branch
}
